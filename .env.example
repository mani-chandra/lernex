# Database — replace ENTIRE line below with your real Neon URL (not USER/HOST placeholders)
# Copy from: Neon dashboard → Connection string, OR Vercel → Settings → Environment Variables → DATABASE_URL
# Example shape: postgresql://neondb_owner:xxxx@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="PASTE_YOUR_NEON_CONNECTION_STRING_HERE"

# Auth (NextAuth) — required
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Local:
AUTH_URL="http://localhost:3000"
# Production (Vercel): set to https://YOUR-PROJECT.vercel.app

# Admin seed (run once: npm run db:seed)
ADMIN_EMAIL="admin@lernex.local"
ADMIN_PASSWORD="changeme123"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Public site copy
NEXT_PUBLIC_OFFICE_ADDRESS="Lernex Counseling Center, Hyderabad, Telangana"
NEXT_PUBLIC_OFFICE_HOURS="Mon–Sat, 10:00 AM – 6:00 PM"
