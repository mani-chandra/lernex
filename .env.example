# Database (PostgreSQL — required for Vercel)
# Local: use a free Neon project (https://neon.tech) or Docker Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth (NextAuth) — required
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Local:
AUTH_URL="http://localhost:3000"
# Production (Vercel): set to https://YOUR-PROJECT.vercel.app

# Admin seed (run once: npm run db:seed)
ADMIN_EMAIL="admin@lernex.local"
ADMIN_PASSWORD="changeme123"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Public site copy
NEXT_PUBLIC_OFFICE_ADDRESS="Lernex Counseling Center, Hyderabad, Telangana"
NEXT_PUBLIC_OFFICE_HOURS="Mon–Sat, 10:00 AM – 6:00 PM"
